{
  "name": "deskbridge",
  "private": true,
  "version": "0.1.0",
  "description": "Control multiple Windows PCs from your phone through a self-hosted relay.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
